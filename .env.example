# =============================================================================
# pMusic — Variables de entorno opcionales / Optional Environment Variables
# =============================================================================
# Copia este archivo a `.env` solo si deseas activar la sincronización gratuita
# entre PC y móvil con Supabase o Discord Rich Presence en Windows.
#
# MODO LOCAL / OFFLINE FIRST:
# Si omites estas variables o las dejas vacías, pMusic arranca y funciona
# completamente en modo local (IndexedDB / almacenamiento del dispositivo) sin
# bloqueos de inicio de sesión ni alertas.
#
# Copy this file to `.env` only to enable free Supabase cross-device sync or
# Windows Discord Rich Presence. Leaving them empty runs pMusic in full
# local-only mode with zero errors.
# =============================================================================

# --- Supabase Free Tier (Sincronización PC <-> Móvil + Control Remoto) -------
# Obtén estos valores en: Supabase Dashboard -> Project Settings -> API
# IMPORTANTE: Usa SIEMPRE la clave pública `anon` (NUNCA `service_role`).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Discord Rich Presence (Solo PC Windows / Electron) ----------------------
# Application Client ID opcional creado en https://discord.com/developers/applications
# Si está vacío o Discord está cerrado, pMusic omite RPC silenciosamente.
DISCORD_CLIENT_ID=
